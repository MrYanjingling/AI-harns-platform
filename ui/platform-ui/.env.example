# 使用内置 mock 数据,无需启动 Go 后端。
# true 时 Vite 不会注册任何 proxy。
VITE_USE_MOCK=true

# 网关服务(cmd/gateway)地址,默认端口 32200
VITE_GATEWAY_TARGET=http://127.0.0.1:32200

# 平台服务(cmd/platform)地址,默认端口 32300
VITE_PLATFORM_TARGET=http://127.0.0.1:32300

# 生产环境可分别指定各服务的基址,默认均为 /api/v1。
# VITE_GATEWAY_BASE=https://gateway.example.com/api/v1
# VITE_PLATFORM_BASE=https://platform.example.com/api/v1

# MinIO 公共读地址(可选)。配置后设备图片按 <base>/<key> 预览,否则只显示对象 Key。
# VITE_MINIO_PUBLIC_BASE=http://127.0.0.1:9000/harns
